generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  courses Course[]
}

/// Un cours importe par l'etudiant : texte colle ou PDF a couche texte.
model Course {
  id        String   @id @default(uuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title     String
  subject   String?
  /// Contenu brut. Traverse le pipeline d'anonymisation avant tout envoi.
  content   String
  charCount Int
  /// Empreinte du contenu : sert de cle de cache, un cours inchange n'est pas reanalyse.
  hash      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  summaries Summary[]
  quizzes   Quiz[]
  messages  ChatMessage[]

  @@index([ownerId, createdAt])
}

/// Module 1 — resume automatique.
model Summary {
  id       String @id @default(uuid())
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  /// Sortie validee : { abstract, keyPoints[], keywords[], warnings[] }
  payload Json
  /// Niveau de detail demande : court, standard, detaille.
  level   String @default("standard")

  // Telemetrie — support du banc d'essai et du chapitre d'evaluation.
  model         String
  promptVersion String
  temperature   Decimal @db.Decimal(3, 2)
  tokensIn      Int?
  tokensOut     Int?
  latencyMs     Int?
  sentPayload   String

  createdAt DateTime @default(now())

  @@index([courseId, createdAt])
}

/// Module 2 — quiz a choix multiples genere depuis le cours.
model Quiz {
  id       String @id @default(uuid())
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  /// Sortie validee : { questions: [{ question, options[4], correctIndex, explanation, sourceQuote }] }
  payload       Json
  questionCount Int
  difficulty    String @default("standard")

  model         String
  promptVersion String
  temperature   Decimal @db.Decimal(3, 2)
  tokensIn      Int?
  tokensOut     Int?
  latencyMs     Int?
  sentPayload   String

  createdAt DateTime @default(now())

  attempts QuizAttempt[]

  @@index([courseId, createdAt])
}

/// Une session de revision : les reponses de l'etudiant et son score.
model QuizAttempt {
  id     String @id @default(uuid())
  quizId String
  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)

  /// Indices choisis par l'etudiant, dans l'ordre des questions.
  answers   Json
  score     Int
  total     Int
  createdAt DateTime @default(now())

  @@index([quizId, createdAt])
}

/// Module 3 — chatbot ancre sur le cours.
model ChatMessage {
  id       String @id @default(uuid())
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  role    String // 'user' | 'assistant'
  content String
  /// Extraits du cours sur lesquels la reponse s'appuie. Vide => hors cours.
  sources Json?
  /// Faux quand le modele declare que le cours ne permet pas de repondre.
  grounded Boolean @default(true)

  model         String?
  promptVersion String?
  tokensIn      Int?
  tokensOut     Int?
  latencyMs     Int?

  createdAt DateTime @default(now())

  @@index([courseId, createdAt])
}

/// Support du chapitre d'evaluation (AA5).
model BenchmarkRun {
  id            String   @id @default(uuid())
  task          String // summarize | quiz | chat
  corpusVersion String
  promptVersion String
  model         String
  metrics       Json
  createdAt     DateTime @default(now())
}
