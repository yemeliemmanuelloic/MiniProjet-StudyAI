# --- Base de donnees (Supabase) -------------------------------------------
# Panneau « Connect » du projet -> onglet ORM -> Prisma. Copier les DEUX lignes.
#   DATABASE_URL : transaction pooler, port 6543 -> execution de l'application
#   DIRECT_URL   : session pooler,     port 5432 -> migrations Prisma
# Remplacer [YOUR-PASSWORD], crochets compris, par le mot de passe de la base.
DATABASE_URL=postgresql://postgres.REF:MOTDEPASSE@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.REF:MOTDEPASSE@aws-0-REGION.pooler.supabase.com:5432/postgres

# --- Securite ---
JWT_SECRET=change-me-in-production

# --- Serveur ---
PORT=3002
CLIENT_ORIGIN=http://localhost:5174

# --- Fournisseur de modele -------------------------------------------------
# Changer de fournisseur ne demande aucune modification de code : seulement
# ces trois lignes, plus la clef correspondante ci-dessous.
#
#   Gemini    (gratuit)  LLM_PROVIDER=gemini     LLM_MODEL=gemini-3.5-flash-lite
#   Anthropic (payant)   LLM_PROVIDER=anthropic  LLM_MODEL=claude-sonnet-5
#
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_MS=30000
MAX_CV_CHARS=20000

# --- Clefs : renseigner UNIQUEMENT celle du fournisseur actif ---
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
