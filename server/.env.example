# --- Base de donnees (Supabase) -------------------------------------------
# Panneau « Connect » du projet -> onglet ORM ou Postgres. Copier les DEUX lignes.
#   DATABASE_URL : transaction pooler, port 6543 -> execution de l'application
#   DIRECT_URL   : session pooler,     port 5432 -> migrations Alembic
# Remplacer MOTDEPASSE par le mot de passe de la base.
#
# Si l'URL copiee contient « ?pgbouncer=true », laissez-le : le serveur le
# retire tout seul (ce parametre est propre a Prisma et libpq le refuse).
DATABASE_URL=postgresql://postgres.REF:MOTDEPASSE@aws-0-REGION.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.REF:MOTDEPASSE@aws-0-REGION.pooler.supabase.com:5432/postgres

# --- Securite ---
# Generer avec : python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production

# --- Serveur ---
PORT=3002
CLIENT_ORIGIN=http://localhost:5174

# --- Fournisseur de modele -------------------------------------------------
# Changer de fournisseur ne demande aucune modification de code : seulement
# ces deux lignes, plus la clef correspondante ci-dessous.
#
#   Gemini    (gratuit)  LLM_PROVIDER=gemini     LLM_MODEL=gemini-3.5-flash-lite
#   Anthropic (payant)   LLM_PROVIDER=anthropic  LLM_MODEL=claude-sonnet-5
#
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_MS=30000

# --- Decoupage des cours ---------------------------------------------------
# Un cours plus long que SEGMENT_CHARS est traite par segments au lieu d'etre
# tronque. MAX_SEGMENTS borne le nombre d'appels : au-dela, le cours est
# ampute, mais l'etudiant en est averti a l'ecran.
MAX_COURSE_CHARS=200000
SEGMENT_CHARS=8000
SEGMENT_OVERLAP=400
MAX_SEGMENTS=24
SEGMENTS_CHAT=3
SEGMENTS_QUIZ=4

# --- Clefs : renseigner UNIQUEMENT celle du fournisseur actif ---
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
